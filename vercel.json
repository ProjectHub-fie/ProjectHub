{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/pages/api/index.ts"
    },
    {
      "source": "/assets/:path*",
      "destination": "/pages/api/index.ts"
    },
    {
      "source": "/:path*",
      "destination": "/pages/api/index.ts"
    }
  ]
}