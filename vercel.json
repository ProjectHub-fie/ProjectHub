{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    },
    {
      "src": "pages/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/admin/login",
      "dest": "pages/api/index.ts"
    },
    {
      "src": "/api/admin/create",
      "dest": "pages/api/index.ts"
    },
    {
      "src": "/api/admin/logout",
      "dest": "pages/api/index.ts"
    },
    {
      "src": "/api/admin/list",
      "dest": "pages/api/index.ts"
    },
    {
      "src": "/api/admin/stats",
      "dest": "pages/api/index.ts"
    },
    {
      "src": "/api/users",
      "dest": "pages/api/index.ts"
    },
    {
      "src": "/api/project-requests",
      "dest": "pages/api/index.ts"
    },
    {
      "src": "/api/projects/(.*)",
      "dest": "pages/api/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "pages/api/index.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}