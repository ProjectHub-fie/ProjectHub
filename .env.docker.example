# Copy to `.env` and fill in. `docker compose` reads `.env` automatically.
#
# Nothing here is committed with real values; `.env` is already in .gitignore and
# .dockerignore, so a secret never reaches git or the image.

# Signing key for sessions and user tokens. Generate one, do not reuse.
#   openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Where the database lives.
#
# Leave this commented out to use the `db` service from docker-compose.yml, which
# the app reaches by its service name:
#   DATABASE_URL=postgres://projecthub:projecthub@db:5432/projecthub?sslmode=disable
#
# A managed database (Neon) goes here instead, with `sslmode=require` and no
# `sslmode=disable`:
#   DATABASE_URL=postgres://user:password@host/db?sslmode=require
#DATABASE_URL=

# Optional: keep mailbox write volume on its own database.
#MAIL_DATABASE_URL=

# Discord bot. The token is environment-only and never stored in the database.
# Required only if you run the `bot` service. BOT_TOKEN, DISCORD_TOKEN, TOKEN and
# CLIENT_TOKEN are accepted as aliases, in that order; the boot log names which
# one supplied the token.
DISCORD_BOT_TOKEN=

# Optional: verbose bot logging. `bot:*` prints the full gateway handshake, every
# message and every &dev resolution. DEBUG=bot:* works the same way. Tokens are
# stripped from all log output either way.
#BOT_DEBUG=bot:*

# Optional: alerting. Without DISCORD_BOT_TOKEN the bot refuses to start; without
# NEON_API_KEY the usage alert is skipped and everything else still works.
NEON_API_KEY=
#NEON_PROJECT_IDS=
#NEON_ORG_ID=

# Public origin, used to build the Discord callback URL.
APP_ORIGIN=http://localhost:5000

# Optional Discord OAuth.
#
# The public client can sign in with Discord; the admin dashboard cannot. On the
# admin side Discord is only a link, made from /pbad/integrations by an
# already-signed-in administrator so the bot can report their role in &dev.
# Both use the same application, so set all four of these together:
#
#   DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET   the application's credentials
#   APP_ORIGIN                                  must be the public origin, not
#                                               localhost, because Discord only
#                                               redirects to an allow-listed URL
#
# Then add both redirect URLs to the Discord application's OAuth2 redirect
# allow-list (Discord shows an "Invalid OAuth2 redirect_uri" page if one is
# missing, and the callback reports `token_exchange` if the value does not match
# byte for byte):
#
#   <APP_ORIGIN>/api/auth/discord/callback         (client sign-in)
#   <APP_ORIGIN>/api/admin/auth/discord/callback   (admin linking)
#
# Without these the linking button fails with `not_configured`; there is no
# default, so nothing is enabled by accident.
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=

# Only needed when the two callbacks are registered under a different host than
# APP_ORIGIN, or when one is registered but not the other. Each overrides the
# derived value for its own flow.
#DISCORD_CALLBACK_URL=
#DISCORD_ADMIN_CALLBACK_URL=

# Admin login used by tests/admin-auth.test.mjs. Those tests are skipped, not
# failed, when these are empty.
ADMIN_PIN=
ADMIN_PASSWORD=

# Ports on the host.
APP_PORT=5000
POSTGRES_PORT=5433
POSTGRES_USER=projecthub
POSTGRES_PASSWORD=projecthub
POSTGRES_DB=projecthub
