# Copy to `.env` and fill in. `docker compose` reads `.env` automatically.
#
# Nothing here is committed with real values; `.env` is already in .gitignore and
# .dockerignore, so a secret never reaches git or the image.

# Signing key for sessions and user tokens. Generate one, do not reuse.
#   openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Where the database lives.
#
# Leave this commented out to use the `db` service from docker-compose.yml, which
# the app reaches by its service name:
#   DATABASE_URL=postgres://projecthub:projecthub@db:5432/projecthub?sslmode=disable
#
# A managed database (Neon) goes here instead, with `sslmode=require` and no
# `sslmode=disable`:
#   DATABASE_URL=postgres://user:password@host/db?sslmode=require
#DATABASE_URL=

# Optional: keep mailbox write volume on its own database.
#MAIL_DATABASE_URL=

# Discord bot. The token is environment-only and never stored in the database.
# Required only if you run the `bot` service.
DISCORD_BOT_TOKEN=

# Optional: alerting. Without DISCORD_BOT_TOKEN the bot refuses to start; without
# NEON_API_KEY the usage alert is skipped and everything else still works.
NEON_API_KEY=
#NEON_PROJECT_IDS=
#NEON_ORG_ID=

# Public origin, used to build the Discord callback URL.
APP_ORIGIN=http://localhost:5000

# Optional Discord OAuth (linking a Discord account from either portal).
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=

# Admin login used by tests/admin-auth.test.mjs. Those tests are skipped, not
# failed, when these are empty.
ADMIN_PIN=
ADMIN_PASSWORD=

# Ports on the host.
APP_PORT=5000
POSTGRES_PORT=5433
POSTGRES_USER=projecthub
POSTGRES_PASSWORD=projecthub
POSTGRES_DB=projecthub
