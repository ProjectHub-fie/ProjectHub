# TypeScript files with JavaScript equivalents (to prevent Vercel conflicts)
# Exclude vite config files as they're needed for build process
!vite.config.ts
!vite.config.js
**/*.ts
!**/node_modules/**/*.ts

# Specific API TypeScript files that have JS counterparts
api/lib/*.ts
api/handlers/**/*.ts
shared/*.ts
drizzle/*.ts

