# Test files and directories.
#
# These are anchored on purpose. A bare pattern like `test*` is matched by
# Vercel against *any* path segment, so it silently stripped
# `api/_lib/test-routes.js` out of the serverless bundle while the import of it
# stayed — the function then died at load with ERR_MODULE_NOT_FOUND. Root-only
# files use a leading `/`; genuinely recursive patterns use an explicit `**/`.
# Never add an unanchored bare glob here: it will delete a shipped module whose
# name happens to start with `test`.
/tests/
**/__tests__/
**/spec/
**/specs/

# Root-level ad-hoc test scripts (not shipped; the runner suite lives in tests/)
/test*.js
/test*.html
/*-test.js
/*.test.js
/*.spec.js

# Test scripts and utilities
/test-api.js
/test-auth.js
/test-db.js
/test-imports.js
/test-integration.js
/detailed-auth-test.js
/setup-testdb.js
/verify-deployment.js
/verify-imports.js

# Test utilities and temporary files
**/test-utils/
**/testing/
**/temp-tests/

# Build scripts to exclude
scripts/setup-testdb.js
scripts/verify-deployment.js
scripts/verify-imports.js

# Server files (exclude for static frontend deployment)
server/

# Development and build artifacts
node_modules/
.git/
.github/
.vscode/
.env
.env.local
.env.development
.env.production
.env.test
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.nyc_output/
coverage/
.nyc_output/
.coverage/
.tmp/
.temp/
.cache/

# Editor and IDE files
.editorconfig
.eslintrc*
.prettierrc*
.stylelintrc*
.vscode/
.idea/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Documentation and config files not needed in production
README.md
CONTRIBUTING.md
LICENSE
CHANGELOG.md
TROUBLESHOOTING.md
netlify.toml

# Build output directories (these will be regenerated)
build/
dist/

# Orphaned API build output: nothing references it, and a stale `api/*` tree
# under it would be misread as serverless functions. Removed, keep it gone.
api-dist/

# Local development files
.vercel/
.next/
.nuxt/
.vuepress/